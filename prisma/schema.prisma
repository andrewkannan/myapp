generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(uuid())
  abbreviation String     @unique
  fullName     String?
  role         String?
  password     String     @default("password123")
  accessLevel  String     @default("STAFF")
  auditLogs    AuditLog[]
  shifts       Shift[]
}

model Location {
  id       String    @id @default(uuid())
  name     String    @unique
  stations Station[]
}

model Station {
  id         String   @id @default(uuid())
  name       String
  locationId String
  shifts     Shift[]
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([name, locationId])
}

model Shift {
  id          String   @id @default(uuid())
  date        DateTime
  shiftPeriod String   @default("Full")
  startTime   String?
  endTime     String?
  status      String   @default("Scheduled")
  remarks     String?
  userId      String
  stationId   String?
  station     Station? @relation(fields: [stationId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([date])
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?
  action    String
  details   String?
  user      User?    @relation(fields: [userId], references: [id])
}
