generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  abbreviation String?    @unique
  fullName     String?
  role         String?
  password     String     @default("password123")
  email        String?
  modality     String?
  isActive     Boolean    @default(true)
  ssoEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  shifts       Shift[]
  leaves       Leave[]
  leaveBalances LeaveBalance[]
}

model Location {
  id       String    @id @default(uuid())
  name     String    @unique
  stations Station[]
}

model Station {
  id         String   @id @default(uuid())
  name       String
  locationId String
  shifts     Shift[]
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([name, locationId])
}

model Shift {
  id          String   @id @default(uuid())
  date        DateTime
  shiftPeriod String   @default("Full")
  startTime   String?
  endTime     String?
  status      String   @default("Scheduled")
  remarks     String?
  userId      String
  stationId   String?
  station     Station? @relation(fields: [stationId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([date])
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?
  action    String
  details   String?
  user      User?    @relation(fields: [userId], references: [id])
}

model SystemRole {
  id          String  @id @default(uuid())
  name        String  @unique
  permissions String?
}

model SystemModality {
  id   String @id @default(uuid())
  name String @unique
}

model Leave {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  period      String   @default("FULL") // "FULL", "AM", "PM"
  type        String   @default("AL")   // "AL", "MC", "UPL", "OFF"
  status      String   @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"
  remarks     String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model LeaveBalance {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  year        Int
  totalDays   Float    // e.g., 21.0
  usedDays    Float    @default(0)

  @@unique([userId, year])
}

model PublicHoliday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  name        String
}